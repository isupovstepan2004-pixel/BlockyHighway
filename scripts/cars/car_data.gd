static func has_car(id: String) -> bool:
    return STATS.has(id)


static func get_stats(id: String) -> Dictionary:
    return (STATS[id] as Dictionary).duplicate(true)


static func default_paint(id: String) -> Color:
    return (STATS[id] as Dictionary)["default_paint"]
